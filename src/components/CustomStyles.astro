<style is:inline is:global>
  :root {
    --aw-font-sans: 'InterVariable', sans-serif;
    --aw-font-serif: 'InterVariable', serif;
    --aw-font-heading: 'InterVariable', sans-serif;

    /* Smart Tech Palette (Light Mode) */
    --aw-color-primary: rgb(14, 116, 144);      /* Deep Tech Cyan */
    --aw-color-secondary: rgb(30, 41, 59);     /* Clean Slate Charcoal */
    --aw-color-accent: rgb(6, 182, 212);        /* Vibrant Tapo Cyan */

    --aw-color-text-heading: rgb(15, 23, 42);  /* Dark Slate for Titles */
    --aw-color-text-default: rgb(71, 85, 105); /* Soft Slate for Body Text */
    --aw-color-bg-page: rgb(255, 255, 255);    /* Pure White Background */

    --aw-color-bg-page-dark: rgb(15, 23, 42);
  }

  .dark {
    /* Smart Tech Palette (Dark Mode) */
    --aw-color-primary: rgb(34, 211, 238);     /* Bright Electric Cyan */
    --aw-color-secondary: rgb(51, 65, 85);     /* Medium Slate */
    --aw-color-accent: rgb(6, 182, 212);        /* Tapo Cyan */

    --aw-color-text-heading: rgb(248, 250, 252); /* Off-White for Titles */
    --aw-color-text-default: rgb(203, 213, 225); /* Light Grey for Body Text */
    --aw-color-bg-page: rgb(11, 19, 36);        /* Deep Premium Midnight Navy */
  }
</style>
