---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'The Smart Home People — TP-Link Tapo Resource Hub',
  ignoreTitleTemplate: true,
};
---

<Layout {metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Read the Blog',
        href: '/blog',
        icon: 'tabler:book',
      },
      { text: 'Learn More', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.jpg', alt: 'Smart Home Security' }}
  >
    <fragment slot="title">
      Smart Home Security & Automation Made <span class="text-accent dark:text-white highlight">Simple</span>
    </fragment>

    <fragment slot="subtitle">
      <span class="font-semibold">The Smart Home People</span> is your ultimate guide to mastering the TP-Link Tapo ecosystem. Whether you are protecting your family home, managing an Airbnb remotely, or monitoring a rural weekender, we provide clear, real-world guides to maximize your tech.
    </fragment>
  </Hero>

  <Note />

  <Features2
    id="features"
    title="Tailored Smart Solutions"
    subtitle="Discover how cost-effective TP-Link Tapo hardware solves unique security and automation problems across different properties."
    items={[
      {
        title: 'Residential & Family Homes',
        description:
          'Keep your loved ones safe with smart alerts, AI-driven motion tracking cameras, and automated lighting rules that make your house look occupied even when you are away.',
        icon: 'tabler:home',
      },
      {
        title: 'Airbnb & Rental Hosts',
        description:
          'Manage check-ins seamlessly, audit energy usage with smart plugs, monitor external perimeters remotely, and automate climate controls to drastically lower utility bills between guest stays.',
        icon: 'tabler:building-estate',
      },
      {
        title: 'Rural Property & Weekenders',
        description:
          'Monitor distant sheds, livestock gates, or off-grid holiday homes using long-lasting battery cameras and weather-resistant smart sensors—no complex server configurations required.',
        icon: 'tabler:plant',
      },
    ]}
  />

  <Steps
    title="Get your smart home running perfectly"
    items={[
      {
        title: 'Step 1: Choose the Right Hardware',
        description:
          'Skip the expensive ecosystems. We review and recommend the absolute best Tapo plugs, switches, and cameras for your exact budget and environment.',
        icon: 'tabler:package',
      },
      {
        title: 'Step 2: Optimize Your Setup',
        description:
          'Follow our step-by-step optimization blueprints for storage, battery life preservation, and rock-solid local connection configurations.',
        icon: 'tabler:settings',
      },
      {
        title: 'Step 3: Automate Everything',
        description:
          'Create highly effective smart routines that run automatically in the background, giving you total hands-off peace of mind.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Ready!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1615874959474-d609969a20ed?ixlib=rb-4.0.3&auto=format&fit=crop&w=774&q=80',
      alt: 'Smart Home Automation Concept',
    }}
  />

  <BlogLatestPosts
    title="Latest Newsletters & Deep-Dive Guides"
    information={`Our archive is constantly expanding with actionable advice. Dive into our latest guides to fix connection drops, audit power draw, and secure your property network.`}
  />
</Layout>
